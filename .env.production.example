# Template for the .env.production file that lives on the droplet, next to
# compose.production.yaml. Never commit the filled-in copy.
#
# The deploy job aborts before restarting anything when this file is missing or
# when DATABASE_URL, APP_JWT_SECRET, or DISCORD_BOT_TOKEN is blank.

APP_ENV=production

# PostgreSQL runs on the host, not in this stack, so the host is reached through
# the host-gateway alias declared in compose.production.yaml. The host must
# accept connections from the pinned 172.20.0.0/16 subnet: see the Deployment
# section of README.md for the listen_addresses and pg_hba.conf entries.
DATABASE_URL=postgres://sot:replace-with-a-strong-password@host.docker.internal:5432/sot_db?sslmode=disable

# Web API. APP_JWT_SECRET must be at least 32 characters and must not reuse
# AUTH_SECRET or the Discord client secret: openssl rand -base64 48
APP_JWT_SECRET=replace-with-at-least-32-random-characters
# Single control for login lifetime across both repositories. Maximum: 24h.
APP_JWT_TTL=1h

# Internal readiness endpoint used by Docker. No host port is published.
BOT_HEALTH_ADDRESS=:8081

# Host-side publish target for the API container, proxied by Caddy. Pick a free
# port: the droplet already runs another API on 8080 and a frontend on 3000.
API_BIND_ADDRESS=127.0.0.1
API_PORT=8081

# Discord
DISCORD_BOT_TOKEN=replace-with-your-bot-token
DISCORD_GUILD_ID=replace-with-your-guild-id
DISCORD_ROLE_ID=replace-with-your-production-member-role-id
DISCORD_ADMIN_IDS=replace-with-admin-role-id
DISCORD_POLL_INTERVAL=5000
# Rotate Discord and CFX player-count statuses every 2.5 seconds.
DISCORD_POLL_STATUS=2500
DISCORD_COMMAND_PREFIX=!
DISCORD_PLAYER_LOG_CHANNEL_ID=replace-with-your-player-log-channel-id
DISCORD_PLAYER_CHAT_CHANNEL_ID=replace-with-your-player-chat-channel-id
DISCORD_PLAYER_RECAP_CHANNEL_ID=replace-with-your-player-recap-channel-id
DISCORD_OFFICE_MONEY_CHANNEL_ID=replace-with-your-office-money-channel-id
DISCORD_DIRTY_MONEY_CHANNEL_ID=replace-with-your-dirty-money-channel-id
BLACKLISTED_USERS=

# FiveM
FIVEM_SERVER_NAME=CR Roleplay
# Cfx.re server code, the short identifier in the server's join link.
FIVEM_SERVER_CFX_ID=kr7k7d
FIVEM_PLAYER_ID=SOT
FIVEM_SERVER_CFX_POLL_INTERVAL=60000
